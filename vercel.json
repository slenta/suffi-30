{
  "buildCommand": "pip install pygbag && python -m pygbag --build .",
  "outputDirectory": "build/web",
  "installCommand": "echo 'Dependencies installed in buildCommand'",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
